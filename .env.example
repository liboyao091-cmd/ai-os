# Database
DATABASE_URL=postgresql://dsaios:password@localhost:5432/ds_ai_os

# Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Internal LLM Gateway (OpenAI-compatible)
LLM_GATEWAY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_GATEWAY_TOKEN=your-internal-token-here
LLM_DEFAULT_MODEL=doubao-pro-32k-241215
LLM_EMBEDDING_MODEL=doubao-embedding-large-text-240915

# Lark Bot
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your-lark-app-secret

# App
APP_SECRET_KEY=change-me-in-production
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,app://

# Vector dimension (match embedding model output)
EMBEDDING_DIM=2048
